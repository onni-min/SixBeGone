{
  "name": "sixbegone",
  "description": "Removes GTA 6 content from YouTube (X, TikTok and Instagram planned).",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "wxt": "^0.21.5"
  }
}
